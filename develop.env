# develop.env — delta sobre o .env canônico para o stack Docker de desenvolvimento.
# Espelha os valores também forçados por compose.local.yaml.
# Variáveis iguais em todos os ambientes ficam em .env (LOG_CHANNEL, LOG_STDERR_FORMATTER, etc.).
APP_ENV=development
APP_DEBUG=true
APP_URL=https://develop.ct12rounds.com.br
LOG_LEVEL=debug
DB_HOST=db
DB_DATABASE=ct12rounds_develop
INERTIA_SSR_ENABLED=false
