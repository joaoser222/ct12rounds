#!/usr/bin/env bash

set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# Detecta o ambiente a partir do APP_ENV do .env do projeto.
# production => modo production; qualquer outro (local/develop) => modo develop.
detect_environment() {
    local app_env
    app_env="$(grep -E '^APP_ENV=' "$project_dir/.env" 2>/dev/null | head -n1 | cut -d= -f2- | tr -d '[:space:]\r"')"

    if [[ "$app_env" == "production" ]]; then
        printf 'production'
    else
        printf 'develop'
    fi
}

environment="$(detect_environment)"

# Permite forçar o ambiente explicitamente como primeiro argumento.
if [[ "$1" == "develop" || "$1" == "production" ]]; then
    environment="$1"
    shift
fi

# Comando especial: build - compila frontend e reinicia app
if [[ "${1:-}" == "build" ]]; then
    shift
    echo "▶ Instalando dependências..."
    npm ci
    echo "▶ Compilando frontend..."
    npm run build:ssr
    echo "▶ Reconstruindo e reiniciando containers..."
    exec "$project_dir/serve" "$environment" up -d --build app "$@"
fi

# Monitoramento habilitado por padrão; use --no-monitoring para desativar.
monitoring=true
for arg in "$@"; do
    if [[ "$arg" == "--no-monitoring" ]]; then
        monitoring=false
        break
    fi
done

base_environment_file=".env"
case "$environment" in
    develop)
        environment_file="develop.env"
        compose_override="compose.develop.yaml"
        compose_local="compose.local.yaml"
        ;;
    production)
        environment_file="production.env"
        compose_override="compose.production.yaml"
        compose_local=""
        ;;
esac

# Profiles adicionais: worker em produção, monitoring por padrão. Cada profile é
# passado com um --profile próprio (o Compose não divide lista separada por vírgula).
profiles=()
if [[ "$environment" == "production" ]]; then
    profiles+=(worker)
fi
if [[ "$monitoring" == true ]]; then
    profiles+=(monitoring)
fi

# O frontend é compilado pelo ambiente de desenvolvimento (npm run build no
# host) e os assets são fornecidos aos containers via volume; o Docker não
# builda o frontend. Não há profile de dev.
compose_files=("$project_dir/compose.yaml" "$project_dir/$compose_override")

if [[ -n "$compose_local" ]]; then
    compose_files+=("$project_dir/$compose_local")
fi

# .env é a base canônica do projeto; o arquivo do ambiente carrega apenas os
# deltas em relação a ela. develop.env é opcional (fluxo local), production.env
# é obrigatório para produção.
env_files=("$project_dir/$base_environment_file")
if [[ -f "$project_dir/$environment_file" ]]; then
    env_files+=("$project_dir/$environment_file")
elif [[ "$environment" == "develop" ]]; then
    echo "Aviso: $environment_file não encontrado; usando apenas $base_environment_file." >&2
else
    echo "Erro: $environment_file é obrigatório para o ambiente $environment." >&2
    exit 1
fi

env_file_args=(--project-directory "$project_dir")
for env_file in "${env_files[@]}"; do
    env_file_args+=(--env-file "$env_file")
done

docker_compose=(docker compose "${env_file_args[@]}")

for file in "${compose_files[@]}"; do
    docker_compose+=(-f "$file")
done

for profile in "${profiles[@]}"; do
    docker_compose+=(--profile "$profile")
done

exec "${docker_compose[@]}" "$@"
